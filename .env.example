# PostgreSQL
POSTGRES_USER=anki
POSTGRES_PASSWORD=anki
POSTGRES_DB=anki_do
POSTGRES_PORT=5433

# Backend
BACKEND_PORT=8001
DATABASE_URL=postgresql+psycopg://anki:anki@localhost:5433/anki_do
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_ENV=development

# Frontend (rodado localmente com npm run dev)
# Vazio no dev: o Vite faz proxy para o backend. Em build de produção, use a URL da API.
VITE_API_URL=
